+// Optional raw stream, in parallel with the unchanged UEFI text protocols.
+STATIC EFI_GUID mTmcRawPs2Guid = TMC_RAW_PS2_PROTOCOL_GUID;
+
+STATIC
+EFI_STATUS
+EFIAPI
+TmcRawReset (TMC_RAW_PS2_PROTOCOL *This)
+{
+  KEYBOARD_CONSOLE_IN_DEV *ConsoleIn;
+  EFI_TPL OldTpl;
+  ConsoleIn = CR (This, KEYBOARD_CONSOLE_IN_DEV, TmcRaw, KEYBOARD_CONSOLE_IN_DEV_SIGNATURE);
+  OldTpl = gBS->RaiseTPL (TPL_NOTIFY);
+  tmc_raw_ps2_reset (&ConsoleIn->TmcRawQueue);
+  gBS->RestoreTPL (OldTpl);
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+TmcRawRead (TMC_RAW_PS2_PROTOCOL *This, UINT8 *Byte)
+{
+  KEYBOARD_CONSOLE_IN_DEV *ConsoleIn;
+  EFI_TPL OldTpl;
+  INTN Result;
+  if (Byte == NULL) { return EFI_INVALID_PARAMETER; }
+  ConsoleIn = CR (This, KEYBOARD_CONSOLE_IN_DEV, TmcRaw, KEYBOARD_CONSOLE_IN_DEV_SIGNATURE);
+  OldTpl = gBS->RaiseTPL (TPL_NOTIFY);
+  Result = tmc_raw_ps2_pop (&ConsoleIn->TmcRawQueue, Byte);
+  gBS->RestoreTPL (OldTpl);
+  return Result < 0 ? EFI_DEVICE_ERROR : (Result == 0 ? EFI_NOT_READY : EFI_SUCCESS);
+}
